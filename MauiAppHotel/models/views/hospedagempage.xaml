<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppHotel.Views.HospedagemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="App Hotel"
    BackgroundColor="#F4F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14"
                             MaximumWidthRequest="600"
                             HorizontalOptions="Center">

            <!-- Cabeçalho -->
            <Border BackgroundColor="#36BDBD" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="🏨 Hotel Mar Azul" FontSize="24" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Escolha seu quarto e planeje sua estadia" FontSize="14" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Quarto -->
            <Label Text="Tipo de quarto" FontAttributes="Bold" TextColor="#1E7886" />
            <Picker x:Name="pck_quarto"
                    Title="Selecione um quarto"
                    TitleColor="Gray"
                    TextColor="#222222"
                    ItemDisplayBinding="{Binding Descricao}" />

            <!-- Datas -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Label Text="Check-in" FontAttributes="Bold" TextColor="#1E7886" />
                <Label Grid.Column="1" Text="Check-out" FontAttributes="Bold" TextColor="#1E7886" />

                <DatePicker x:Name="dtpck_checkin" Grid.Row="1" Format="dd/MM/yyyy"
                            TextColor="#222222"
                            DateSelected="dtpck_checkin_DateSelected" />
                <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1" Format="dd/MM/yyyy"
                            TextColor="#222222" />
            </Grid>

            <!-- Hóspedes -->
            <Label Text="Hóspedes" FontAttributes="Bold" TextColor="#1E7886" />

            <Border BackgroundColor="White" Stroke="#36BDBD" StrokeThickness="1" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <Label Text="Adultos" TextColor="#222222" VerticalOptions="Center" />
                        <Label x:Name="lbl_adultos" Grid.Column="1" Text="1" FontSize="18"
                               FontAttributes="Bold" TextColor="#1E7886" VerticalOptions="Center" />
                        <Stepper x:Name="stp_adultos" Grid.Column="2" Minimum="1" Maximum="4"
                                 Increment="1" Value="1" ValueChanged="stp_adultos_ValueChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <Label Text="Crianças" TextColor="#222222" VerticalOptions="Center" />
                        <Label x:Name="lbl_criancas" Grid.Column="1" Text="0" FontSize="18"
                               FontAttributes="Bold" TextColor="#1E7886" VerticalOptions="Center" />
                        <Stepper x:Name="stp_criancas" Grid.Column="2" Minimum="0" Maximum="4"
                                 Increment="1" Value="0" ValueChanged="stp_criancas_ValueChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Calcular reserva"
                    BackgroundColor="#1E7886"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="12"
                    Margin="0,10,0,0"
                    Clicked="Button_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>