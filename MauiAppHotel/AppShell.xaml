<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiAppHotel.Views"
    Shell.BackgroundColor="#1E7886"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.TabBarBackgroundColor="#1E7886"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#BFE6EA">

    <TabBar>
        <ShellContent
            Title="Reservar"
            ContentTemplate="{DataTemplate views:HospedagemPage}"
            Route="Hospedagem" />

        <ShellContent
            Title="Sobre"
            ContentTemplate="{DataTemplate views:SobrePage}"
            Route="Sobre" />
    </TabBar>
</Shell>
